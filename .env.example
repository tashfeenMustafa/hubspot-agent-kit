# hubspot-agent-kit environment — copy to .env and fill in.
# .env is gitignored; .env.example is committed. Never commit real tokens.

# --- Safety (shipped default) ---
# All writes default to dry-run. Set to false ONLY for an explicit, confirmed
# live write; the PreToolUse write-guard hook enforces this at the harness level.
DRY_RUN=true

# --- HubSpot credentials (direct-REST adapter) ---
# Private-app access token for the portal under analysis.
HUBSPOT_ACCESS_TOKEN=

# Optional: pin a portal/account id for multi-portal setups.
HUBSPOT_PORTAL_ID=

# --- HubSpot API (optional overrides) ---
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
