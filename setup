#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Detect OS
OS="$(uname -s)"

# Check Python 3.8+
if command -v python3 &>/dev/null; then
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    if (( $(echo "$PYTHON_VERSION < 3.8" | bc -l) )); then
        echo "Error: Python 3.8 or higher is required. Found Python $PYTHON_VERSION."
        exit 1
    fi
else
    echo "Error: Python 3 is not installed or not found in PATH."
    exit 1
fi

echo "Python $PYTHON_VERSION detected."

# Install dependencies
echo "Installing Python dependencies..."
pip install requests python-dotenv

# Create ~/.hubspot-agent-kit/ directory
KIT_DIR="$HOME/.hubspot-agent-kit"
echo "Creating configuration directory: $KIT_DIR"
mkdir -p "$KIT_DIR"

# Copy .env.example to ~/.hubspot-agent-kit/.env if not exists
ENV_FILE="$KIT_DIR/.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "Copying .env.example to $ENV_FILE"
    cp "$SCRIPT_DIR/.env.example" "$ENV_FILE"
else
    echo ".env file already exists at $ENV_FILE, skipping copy."
fi

# Print success message with next steps
echo ""
echo "==================================================="
echo "HubSpot Agent Kit Setup Complete!"
echo ""
echo "Next steps:"
echo "1. Edit $ENV_FILE and set HUBSPOT_API_KEY and HUBSPOT_PORTAL_ID."
echo ""
echo "2. Agent context files (CLAUDE.md, AGENTS.md, GEMINI.md) are included"
echo "   in the kit at: $SCRIPT_DIR"
echo "   - If you cloned into your project root: they are already active."
echo "   - If you installed into ~/.claude/skills/: copy or symlink CLAUDE.md"
echo "     to your project root:"
echo "     ln -s $SCRIPT_DIR/CLAUDE.md ~/your-project/CLAUDE.md"
echo ""
echo "3. Run your first audit:"
echo "   python $SCRIPT_DIR/scripts/audit/audit_workflows.py --report audit.md"
echo "==================================================="

# Make the script executable
chmod +x "$SCRIPT_DIR/setup"

