#!/usr/bin/env bash

# Detect OS
OS="$(uname -s)"

# Check Python 3.8+
if command -v python3 &>/dev/null; then
    PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    if (( $(echo "$PYTHON_VERSION < 3.8" | bc -l) )); then
        echo "Error: Python 3.8 or higher is required. Found Python $PYTHON_VERSION."
        exit 1
    fi
else
    echo "Error: Python 3 is not installed or not found in PATH."
    exit 1
fi

echo "Python $PYTHON_VERSION detected."

# Install dependencies
echo "Installing Python dependencies..."
pip install requests python-dotenv

# Create ~/.hubspot-agent-kit/ directory
KIT_DIR="$HOME/.hubspot-agent-kit"
echo "Creating configuration directory: $KIT_DIR"
mkdir -p "$KIT_DIR"

# Copy .env.example to ~/.hubspot-agent-kit/.env if not exists
ENV_FILE="$KIT_DIR/.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "Copying .env.example to $ENV_FILE"
    cp D:/tashf/Documents/GitHub/hubspot-agent-kit/.env.example "$ENV_FILE"
else
    echo ".env file already exists at $ENV_FILE, skipping copy."
fi

# Print success message with next steps
echo ""
echo "==================================================="
echo "HubSpot Agent Kit Setup Complete!"
echo "Next steps:"
echo "1. Edit $ENV_FILE and set your HUBSPOT_API_KEY, HUBSPOT_PORTAL_ID, and other variables."
echo "2. Add the following snippet to your Claude Code agent's system prompt or equivalent:"
echo ""
echo '```markdown'
echo '## Claude Code Integration'
echo ''
echo 'When working on any HubSpot-related task, always use the `hubspot-agent-kit` skills.'
echo ''
echo '### Available Commands:'
echo ''
echo '*   `/hs-audit`: Audit all workflows — score every flow against 38 production-tested rules.'
echo '*   `/hs-build`: Describe a workflow in plain English, get it built and deployed.'
echo '*   `/hs-deals`: Create deals, associate contacts, move pipeline stages.'
echo '*   `/hs-meetings`: Backfill meeting types, infer outcomes, manage scheduling pages.'
echo '*   `/hs-utm`: Audit UTM data, build normalization workflows for Meta/Google/LinkedIn.'
echo '*   `/hs-crm`: Find orphan deals, missing associations, lifecycle stage mismatches.'
echo '*   `/hs-calls`: Build call disposition routing and lead status automation.'
echo '*   `/hs-pages`: Download, edit, and publish landing pages.'
echo '*   `/hs-normalize`: Normalize contact properties in bulk.'
echo '*   `/hs-hygiene`: Full CRM hygiene pipeline — close ghost deals, clean stale contacts.'
echo ''
echo '### Overrides:'
echo ''
echo '*   When asked to perform HubSpot-related work, always read the relevant `SKILL.md` file first from the `skills/` directory.'
echo '*   Never call the HubSpot API directly without first consulting and using the defined skills in this kit.'
echo '*   **Important:** Always perform a `DRY_RUN` before executing any write operations to HubSpot.'
echo ''
echo '### References:'
echo ''
echo '*   `scripts/`: Contains Python utilities for various operations.'
echo '*   `rules/`: Defines the audit rules used by `/hs-audit`.'
echo '*   `docs/`: Provides documentation on HubSpot API patterns and best practices.'
echo '```'
echo ""
echo "==================================================="

# Make the script executable
chmod +x D:/tashf/Documents/GitHub/hubspot-agent-kit/setup
